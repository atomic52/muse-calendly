# Calendly Personal Access Token (PAT).
# Create at: https://calendly.com/integrations/api_webhooks
# Paste the token only into this local .env file and into Muse's secure
# credential prompt. Never paste it into the Muse chat and never commit it.
CALENDLY_TOKEN=

# Optional. Defaults to https://api.calendly.com
CALENDLY_BASE_URL=https://api.calendly.com

# --- Booking test (only used with `npm run smoke:book`) ---
# POST /invitees requires a paid Calendly plan.
CALENDLY_INVITEE_EMAIL=
CALENDLY_INVITEE_NAME=Muse Connector Test
CALENDLY_INVITEE_TIMEZONE=America/New_York
# Optional: pin a specific event type instead of using the first one.
CALENDLY_EVENT_TYPE_URI=
# Optional: required when the event type enforces a location (e.g. zoom_conference).
CALENDLY_LOCATION_KIND=
# Optional: reason recorded when --cancel-after cancels the test booking.
CALENDLY_CANCEL_REASON=Muse connector smoke test

# --- Connector bridge (Phase 2) ---
# See docs/bridge.md. The bridge owns Calendly OAuth and exposes a narrow,
# idempotent API that Muse calls with a connector key.

PORT=8787
HOST=0.0.0.0
BRIDGE_PUBLIC_URL=http://localhost:8787
LOG_LEVEL=info

# 32 bytes of hex (64 hex chars). Required in production; dev generates .data/enc.key.
TOKEN_ENCRYPTION_KEY=

# From your Calendly OAuth app (developer.calendly.com). web = Basic auth + secret.
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_OAUTH_MODE=web
CALENDLY_REDIRECT_URI=http://localhost:8787/oauth/calendly/callback
CALENDLY_AUTH_BASE_URL=https://auth.calendly.com
CALENDLY_API_BASE_URL=https://api.calendly.com
CALENDLY_SCOPES=users:read event_types:read availability:read scheduled_events:read scheduled_events:write scheduling_links:write

# memory for tests, file for local persistence.
STORE_KIND=file
STORE_PATH=.data/bridge.json

RATE_LIMIT_PER_MINUTE=120
IDEMPOTENCY_TTL_HOURS=24
