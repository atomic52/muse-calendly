{
  "name": "muse-calendly",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Calendly connector for Meta Muse: zero-code spec experiment + OAuth bridge",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "smoke": "tsx src/smoke.ts",
    "smoke:book": "tsx src/smoke.ts --book --cancel-after",
    "build:spec": "tsx src/build-spec.ts",
    "build:connector-spec": "tsx src/build-connector-spec.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
